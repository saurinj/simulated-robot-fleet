<?xml version="1.0" ?>
<!--
  goal_with_obstacle_world.sdf — Project 2 scenario world #1 (DRAFT, prepared 2026-10-05).

  It has an obstacle and is targeted to test that robot reaches 
  its goal_x and goal_y by moving left when obstacle is encountered

  >>> ROBOT BLOCK: paste your CURRENT diff_bot model block here — the one
  >>> from test_world.sdf WITH your working gpu_lidar sensor block.
  >>> It is deliberately NOT reproduced in this draft: your live block is
  >>> the one verified on your box (Oct 5 lidar rung). The /lidar → /scan
  >>> mapping in config/bridge.yaml applies unchanged (same topic name).

  Install: drop into fleet_gz/worlds/ (setup.py already globs worlds/*.sdf),
  rebuild fleet_gz, launch with:  ros2 launch fleet_gz bringup.launch.py world:=goal_with_obstacle_world.sdf
  (requires the 'world' launch argument — see recipe.)
-->
<sdf version="1.9">
  <world name="goal_with_obstacle_world">

    <physics name="1ms" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <plugin filename="ignition-gazebo-physics-system"
            name="ignition::gazebo::systems::Physics">
    </plugin>
    <plugin filename="ignition-gazebo-scene-broadcaster-system"
            name="ignition::gazebo::systems::SceneBroadcaster">
    </plugin>
    <plugin filename="ignition-gazebo-sensors-system"
        name="ignition::gazebo::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>

    <light type="directional" name="sun">
      <cast_shadows>false</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>100 100</size>
            </plane>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>100 100</size>
            </plane>
          </geometry>
          <material>
            <ambient>0.7 0.7 0.7 1</ambient>
            <diffuse>0.7 0.7 0.7 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- the obstacle: 0.5 m box dead ahead, front face at x = 3.75 -->
    <model name="obstacle">
      <static>true</static>
      <pose>2.0 2.0 0.5 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>0.5 0.5 1.0</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.5 0.5 1.0</size></box></geometry>
          <material>
            <ambient>0.5 0.5 0.5 1</ambient>
            <diffuse>0.5 0.5 0.5 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name="diff_bot">
      <pose>0 0 0 0 0 0</pose>

      <link name="base_link">
        <inertial>
          <pose>0.06 0 0.12 0 0 0</pose>
          <mass>2.0</mass>
          <inertia>
            <ixx>0.0217</ixx><ixy>0</ixy><ixz>0</ixz>
            <iyy>0.0483</iyy><iyz>0</iyz>
            <izz>0.0567</izz>
          </inertia>
        </inertial>
        <collision name="body">
          <pose>0 0 0.12 0 0 0</pose>
          <geometry><box><size>0.5 0.3 0.2</size></box></geometry>
        </collision>
        <visual name="body">
          <pose>0 0 0.12 0 0 0</pose>
          <geometry><box><size>0.5 0.3 0.2</size></box></geometry>
          <material>
            <ambient>0.2 0.4 0.8 1</ambient>
            <diffuse>0.2 0.4 0.8 1</diffuse>
          </material>
        </visual>
        <!-- caster ball merged into the base: keeps the bot level -->
        <collision name="caster">
          <pose>0.18 0 0.03 0 0 0</pose>
          <geometry><sphere><radius>0.03</radius></sphere></geometry>
        </collision>
        <visual name="caster">
          <pose>0.18 0 0.03 0 0 0</pose>
          <geometry><sphere><radius>0.03</radius></sphere></geometry>
        </visual>
        <sensor name="lidar" type="gpu_lidar">
          <topic>/lidar</topic>
          <update_rate>10</update_rate>
          <lidar>
            <scan>
              <horizontal>
                <samples>360</samples>
                <resolution>1</resolution>
                <min_angle>-3.14159265</min_angle>
                <max_angle>3.14159265</max_angle>
              </horizontal>
            </scan>
            <range>
              <min>0.08</min>
              <max>10.0</max>
              <resolution>0.01</resolution>
            </range>
          </lidar>
          <always_on>true</always_on>
          <visualize>false</visualize>
          <pose>0.15 0 0.23 0 0 0</pose>
        </sensor>
      </link>

      <link name="left_wheel">
        <pose>0 0.2 0.05 0 0 0</pose>
        <inertial>
          <mass>0.2</mass>
          <inertia>
            <ixx>0.00015</ixx><ixy>0</ixy><ixz>0</ixz>
            <iyy>0.00025</iyy><iyz>0</iyz>
            <izz>0.00015</izz>
          </inertia>
        </inertial>
        <collision name="collision">
          <pose>0 0 0 1.5707963 0 0</pose>
          <geometry>
            <cylinder><radius>0.05</radius><length>0.04</length></cylinder>
          </geometry>
        </collision>
        <visual name="visual">
          <pose>0 0 0 1.5707963 0 0</pose>
          <geometry>
            <cylinder><radius>0.05</radius><length>0.04</length></cylinder>
          </geometry>
          <material>
            <ambient>0.1 0.1 0.1 1</ambient>
            <diffuse>0.1 0.1 0.1 1</diffuse>
          </material>
        </visual>
      </link>

      <link name="right_wheel">
        <pose>0 -0.2 0.05 0 0 0</pose>
        <inertial>
          <mass>0.2</mass>
          <inertia>
            <ixx>0.00015</ixx><ixy>0</ixy><ixz>0</ixz>
            <iyy>0.00025</iyy><iyz>0</iyz>
            <izz>0.00015</izz>
          </inertia>
        </inertial>
        <collision name="collision">
          <pose>0 0 0 1.5707963 0 0</pose>
          <geometry>
            <cylinder><radius>0.05</radius><length>0.04</length></cylinder>
          </geometry>
        </collision>
        <visual name="visual">
          <pose>0 0 0 1.5707963 0 0</pose>
          <geometry>
            <cylinder><radius>0.05</radius><length>0.04</length></cylinder>
          </geometry>
          <material>
            <ambient>0.1 0.1 0.1 1</ambient>
            <diffuse>0.1 0.1 0.1 1</diffuse>
          </material>
        </visual>
      </link>

      <joint name="left_wheel_joint" type="revolute">
        <parent>base_link</parent>
        <child>left_wheel</child>
        <pose>0 0.2 -0.07 0 0 0</pose>
        <axis>
          <xyz>0 1 0</xyz>
          <limit><lower>-1e16</lower><upper>1e16</upper></limit>
        </axis>
      </joint>

      <joint name="right_wheel_joint" type="revolute">
        <parent>base_link</parent>
        <child>right_wheel</child>
        <pose>0 -0.2 -0.07 0 0 0</pose>
        <axis>
          <xyz>0 1 0</xyz>
          <limit><lower>-1e16</lower><upper>1e16</upper></limit>
        </axis>
      </joint>

      <plugin filename="ignition-gazebo-diff-drive-system"
              name="ignition::gazebo::systems::DiffDrive">
        <left_joint>left_wheel_joint</left_joint>
        <right_joint>right_wheel_joint</right_joint>
        <wheel_separation>0.4</wheel_separation>
        <wheel_radius>0.05</wheel_radius>
        <odom_publish_frequency>50</odom_publish_frequency>
        <topic>/cmd_vel</topic>
        <odom_topic>/odom</odom_topic>
        <frame_id>odom</frame_id>
        <child_frame_id>base_link</child_frame_id>
      </plugin>
    </model>

  </world>
</sdf>
