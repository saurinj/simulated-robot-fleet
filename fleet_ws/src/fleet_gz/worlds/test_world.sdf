<?xml version="1.0" ?>
<!--
  test_world.sdf — minimal headless-friendly world for the Project 2 starter.

  Contents: ground plane, two obstacle boxes, and one differential-drive
  robot (diff_bot) driven by Fortress's DiffDrive system plugin.

  Design note: the model frame and the base_link frame coincide (both at the
  model origin on the ground), so joint poses are unambiguous regardless of
  which frame convention a reader assumes. Wheel geometry is rolled 90 deg
  inside its collision/visual so the cylinder axle lies along Y, matching
  the revolute joint axis (0 1 0).

  Run headless:  ign gazebo -s -r test_world.sdf
-->
<sdf version="1.9">
  <world name="test_world">

    <physics name="1ms" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <plugin filename="ignition-gazebo-physics-system"
            name="ignition::gazebo::systems::Physics">
    </plugin>
    <plugin filename="ignition-gazebo-scene-broadcaster-system"
            name="ignition::gazebo::systems::SceneBroadcaster">
    </plugin>

    <light type="directional" name="sun">
      <cast_shadows>false</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>100 100</size>
            </plane>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>100 100</size>
            </plane>
          </geometry>
          <material>
            <ambient>0.7 0.7 0.7 1</ambient>
            <diffuse>0.7 0.7 0.7 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- obstacles to drive around once teleop works -->
    <model name="box_1">
      <static>true</static>
      <pose>2.0 1.0 0.25 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>0.5 0.5 0.5</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.5 0.5 0.5</size></box></geometry>
        </visual>
      </link>
    </model>

    <model name="box_2">
      <static>true</static>
      <pose>-1.5 -2.0 0.5 0 0 0.6</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>0.5 0.5 1.0</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.5 0.5 1.0</size></box></geometry>
        </visual>
      </link>
    </model>

    <!-- ================= differential-drive robot ================= -->
    <model name="diff_bot">
      <pose>0 0 0 0 0 0</pose>

      <link name="base_link">
        <inertial>
          <pose>0 0 0.12 0 0 0</pose>
          <mass>2.0</mass>
          <inertia>
            <ixx>0.0217</ixx><ixy>0</ixy><ixz>0</ixz>
            <iyy>0.0483</iyy><iyz>0</iyz>
            <izz>0.0567</izz>
          </inertia>
        </inertial>
        <collision name="body">
          <pose>0 0 0.12 0 0 0</pose>
          <geometry><box><size>0.5 0.3 0.2</size></box></geometry>
        </collision>
        <visual name="body">
          <pose>0 0 0.12 0 0 0</pose>
          <geometry><box><size>0.5 0.3 0.2</size></box></geometry>
          <material>
            <ambient>0.2 0.4 0.8 1</ambient>
            <diffuse>0.2 0.4 0.8 1</diffuse>
          </material>
        </visual>
        <!-- caster ball merged into the base: keeps the bot level -->
        <collision name="caster">
          <pose>0.18 0 0.03 0 0 0</pose>
          <geometry><sphere><radius>0.03</radius></sphere></geometry>
        </collision>
        <visual name="caster">
          <pose>0.18 0 0.03 0 0 0</pose>
          <geometry><sphere><radius>0.03</radius></sphere></geometry>
        </visual>
      </link>

      <link name="left_wheel">
        <pose>0 0.2 0.05 0 0 0</pose>
        <inertial>
          <mass>0.2</mass>
          <inertia>
            <ixx>0.00015</ixx><ixy>0</ixy><ixz>0</ixz>
            <iyy>0.00025</iyy><iyz>0</iyz>
            <izz>0.00015</izz>
          </inertia>
        </inertial>
        <collision name="collision">
          <pose>0 0 0 1.5707963 0 0</pose>
          <geometry>
            <cylinder><radius>0.05</radius><length>0.04</length></cylinder>
          </geometry>
        </collision>
        <visual name="visual">
          <pose>0 0 0 1.5707963 0 0</pose>
          <geometry>
            <cylinder><radius>0.05</radius><length>0.04</length></cylinder>
          </geometry>
          <material>
            <ambient>0.1 0.1 0.1 1</ambient>
            <diffuse>0.1 0.1 0.1 1</diffuse>
          </material>
        </visual>
      </link>

      <link name="right_wheel">
        <pose>0 -0.2 0.05 0 0 0</pose>
        <inertial>
          <mass>0.2</mass>
          <inertia>
            <ixx>0.00015</ixx><ixy>0</ixy><ixz>0</ixz>
            <iyy>0.00025</iyy><iyz>0</iyz>
            <izz>0.00015</izz>
          </inertia>
        </inertial>
        <collision name="collision">
          <pose>0 0 0 1.5707963 0 0</pose>
          <geometry>
            <cylinder><radius>0.05</radius><length>0.04</length></cylinder>
          </geometry>
        </collision>
        <visual name="visual">
          <pose>0 0 0 1.5707963 0 0</pose>
          <geometry>
            <cylinder><radius>0.05</radius><length>0.04</length></cylinder>
          </geometry>
          <material>
            <ambient>0.1 0.1 0.1 1</ambient>
            <diffuse>0.1 0.1 0.1 1</diffuse>
          </material>
        </visual>
      </link>

      <joint name="left_wheel_joint" type="revolute">
        <parent>base_link</parent>
        <child>left_wheel</child>
        <pose>0 0.2 0.05 0 0 0</pose>
        <axis>
          <xyz>0 1 0</xyz>
          <limit><lower>-1e16</lower><upper>1e16</upper></limit>
        </axis>
      </joint>

      <joint name="right_wheel_joint" type="revolute">
        <parent>base_link</parent>
        <child>right_wheel</child>
        <pose>0 -0.2 0.05 0 0 0</pose>
        <axis>
          <xyz>0 1 0</xyz>
          <limit><lower>-1e16</lower><upper>1e16</upper></limit>
        </axis>
      </joint>

      <plugin filename="ignition-gazebo-diff-drive-system"
              name="ignition::gazebo::systems::DiffDrive">
        <left_joint>left_wheel_joint</left_joint>
        <right_joint>right_wheel_joint</right_joint>
        <wheel_separation>0.4</wheel_separation>
        <wheel_radius>0.05</wheel_radius>
        <odom_publish_frequency>50</odom_publish_frequency>
        <topic>/cmd_vel</topic>
        <odom_topic>/odom</odom_topic>
        <frame_id>odom</frame_id>
        <child_frame_id>base_link</child_frame_id>
      </plugin>
    </model>

  </world>
</sdf>
